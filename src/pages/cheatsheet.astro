---
/**
 * 速查页 —— 规范见 docs/page-specs.md §5
 *
 * 版式是一张密表：左列命令、右列效果、分组用一条粗线隔开。
 * 打开这一页只有一个动作 —— 找到某个命令然后走，所以扫读密度是唯一指标。
 *
 * 结构由 scripts/sync.mjs 从 Markdown 转换而来（原文是分立的代码块 / 表格 /
 * 段落，合并成一张表不是 CSS 能做的）。这里只负责渲染。
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import kb from '../data/kb.json';

const sheet = kb.cheats?.['/cheatsheet/'];

/** 把 `反引号` 片段切出来，交替渲染成行内 code */
const seg = (s) =>
  String(s ?? '')
    .split('`')
    .map((text, i) => ({ text, code: i % 2 === 1 }));

const rowCount = sheet ? sheet.groups.reduce((n, g) => n + g.rows.length, 0) : 0;
---

<StarlightPage frontmatter={{ title: sheet?.title ?? '速查表', tableOfContents: false }}>
  {
    sheet ? (
      <>
        <p class="kb-meta">
          {sheet.groups.length} 组<i>·</i>{rowCount} 条<i>·</i>可直接打印
        </p>

        <table class="kb-sheet not-content">
          <tbody>
            {sheet.groups.map((g) => (
              <>
                <tr class="grp"><td colspan="2">{g.name}</td></tr>
                {g.note && (
                  <tr class="note">
                    <td colspan="2">
                      {seg(g.note).map((p) => (p.code ? <code>{p.text}</code> : p.text))}
                    </td>
                  </tr>
                )}
                {g.rows.map((r) => (
                  <tr>
                    <th scope="row"><code>{r.cmd}</code></th>
                    <td>{seg(r.desc).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</td>
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>

        {sheet.refs.length > 0 && (
          <div class="kb-sheet-refs not-content">
            <span class="kb-sheet-refs-l">参考</span>
            {sheet.refs.map((r) => (
              <a href={r.href}>{r.text}</a>
            ))}
          </div>
        )}
      </>
    ) : (
      <p class="kb-empty">
        没有解析到速查表内容 —— 先跑 <code>npm run sync</code>。
      </p>
    )
  }
</StarlightPage>
