---
/**
 * 总目录（首页）—— 规范见 docs/page-specs.md §1
 *
 * 只有分区条目网格。统计条与覆盖度块已移除：
 * 每个分区标题右侧的 已写/总数 和侧栏分组标签已经承载了同一份信息，
 * 三处重复反而把首屏推走了 —— 密度优先（设计规范 §2 原则一）。
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import kb from '../data/kb.json';
---

<StarlightPage frontmatter={{ title: '总目录', tableOfContents: false }}>
  {
    kb.cats.map((c) => {
      const w = c.tools.filter((t) => t.path).length;
      return (
        <>
          <h2 class="kb-h2">
            <a href={`/c/${c.slug}/`}>{c.name}</a> <em>{w}/{c.tools.length}</em>
          </h2>
          <div class="kb-grid not-content">
            {c.tools.map((t) =>
              t.path ? (
                <a class="kb-cell" href={t.url}>
                  <div class="kb-cell-n">{t.name}</div>
                  <div class="kb-cell-d">{t.desc}</div>
                </a>
              ) : (
                <span class="kb-cell is-todo">
                  <span class="kb-tag is-todo">待写</span>
                  <div class="kb-cell-n">{t.name}</div>
                  <div class="kb-cell-d">{t.desc}</div>
                </span>
              )
            )}
          </div>
        </>
      );
    })
  }
</StarlightPage>
